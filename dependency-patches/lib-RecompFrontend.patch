diff --git a/recompinput/include/recompinput/menu_input_policy.h b/recompinput/include/recompinput/menu_input_policy.h
new file mode 100644
index 0000000000000000000000000000000000000000..7553b3976ee0b6198b68b79221ff37e104a8b21e
--- /dev/null
+++ b/recompinput/include/recompinput/menu_input_policy.h
@@ -0,0 +1,26 @@
+#pragma once
+#include "input_types.h"
+#include <utility>
+namespace recompinput {
+inline constexpr std::pair<GameInput, GameInput> game_menu_actions[] = {
+    {GameInput::ACCEPT_INGAME_MENU, GameInput::A},
+    {GameInput::BACK_INGAME_MENU, GameInput::B}
+};
+template<class Mappings> bool menu_assigned(const Mappings& mappings, GameInput input) {
+    for (const auto& f : mappings[(size_t)input]) if (!f.is_empty()) return true;
+    return false;
+}
+template<class Mappings> bool menu_reserved(const Mappings& mappings, const InputField& field) {
+    for (auto [action, game] : game_menu_actions)
+        for (const auto& f : mappings[(size_t)action]) if (!f.is_empty() && f == field) return true;
+    return false;
+}
+template<class Mappings, class Read> bool menu_button_down(const Mappings& mappings, GameInput game, bool menu, Read read) {
+    GameInput action = GameInput::COUNT;
+    if (menu) for (auto [candidate, target] : game_menu_actions)
+        if (target == game && menu_assigned(mappings, candidate)) action = candidate;
+    for (const auto& field : mappings[(size_t)(action == GameInput::COUNT ? game : action)])
+        if ((!menu || action != GameInput::COUNT || !menu_reserved(mappings, field)) && read(field)) return true;
+    return false;
+}
+}
